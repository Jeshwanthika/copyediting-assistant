# Copy this file to .env and fill in values. Never commit .env.

# Leave empty to use the default SQLite file at <repo>/data/copy_editing.db
DATABASE_URL=

# Not used yet. Reserved for the AI stage.
LLM_API_KEY=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# --- Login ---
# Long random string used to sign login tokens. Leave empty to auto-generate one
# (stored in data/.auth_secret). Changing it signs everybody out.
AUTH_SECRET_KEY=
AUTH_TOKEN_HOURS=12

# Accounts created the first time the backend starts with an empty users table.
# Set your own passwords BEFORE the first start (or change them later with
#   python -m app.users set-password <username>).
DEFAULT_LEAD_USERNAME=lead
DEFAULT_LEAD_PASSWORD=lead12345
DEFAULT_TRAINEE_USERNAME=trainee
DEFAULT_TRAINEE_PASSWORD=trainee12345

# --- Errors & solutions PDFs ---
# Leave empty to store uploaded PDFs in data/documents/
DOCUMENTS_DIR=
MAX_DOCUMENT_MB=25
